@page
@model yaslibakimapp.Pages.Hesap.KayitModel
@{
    ViewData["Title"] = "Kayıt";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-1">Kayıt ol</h1>
        <p class="text-muted">Bakıcı veya aile yakını hesabı. Yaşlı hesapları yönetici tarafından açılır.</p>

        @if (Model.Hata is not null)
        {
            <div class="alert alert-danger">@Model.Hata</div>
        }

        <form method="post">
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Ad" class="form-label">Ad</label>
                    <input asp-for="Ad" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Soyad" class="form-label">Soyad</label>
                    <input asp-for="Soyad" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Eposta" class="form-label">E-posta</label>
                <input asp-for="Eposta" class="form-control" autocomplete="email" />
                <span asp-validation-for="Eposta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Telefon" class="form-label">Telefon</label>
                <input asp-for="Telefon" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Telefon" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Parola" class="form-label">Parola</label>
                <input asp-for="Parola" class="form-control" autocomplete="new-password" />
                <div class="form-text">En az 8 karakter; harf ve rakam içermeli.</div>
                <span asp-validation-for="Parola" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ParolaTekrar" class="form-label">Parola (tekrar)</label>
                <input asp-for="ParolaTekrar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ParolaTekrar" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Kayıt ol</button>
        </form>

        <p class="mt-3">Zaten hesabınız var mı? <a asp-page="/Hesap/Giris">Giriş yapın</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
