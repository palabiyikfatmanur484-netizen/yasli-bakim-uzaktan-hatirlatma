@page
@model yaslibakimapp.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Giriş</h1>

        @if (Model.Hata is not null)
        {
            <div class="alert alert-danger">@Model.Hata</div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Eposta" class="form-label">E-posta</label>
                <input asp-for="Eposta" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Eposta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Parola" class="form-label">Parola</label>
                <input asp-for="Parola" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Parola" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
        </form>

        <p class="mt-3">Hesabınız yok mu? <a asp-page="/Hesap/Kayit">Bakıcı / yakın olarak kayıt olun</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
